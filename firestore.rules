    match /users/{uid} {
      allow get: if isAdmin() || (activeUser() && request.auth.uid == uid);
      allow list, create, update: if isAdmin();
      allow delete: if false;
    }
    match /roles/{roleId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }
    match /permissions/{permissionId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }
    match /locations/{locationId} {
      allow read: if isAdmin() || (canModule("locations", "view") && allowedLocation(locationId));
      allow create: if canModule("locations", "create");
      allow update: if isAdmin()
        || (canModule("locations", "edit")
          && allowedLocation(locationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name", "type", "codePrefix", "dniMode", "active",
            "scheduleStartAt", "scheduleEndAt", "startDateTime", "endDateTime",
            "manualInactiveUntil", "manualInactiveDays", "updatedBy", "updatedByName",
            "updatedAt"
          ]))
        || (canModule("locations", "archive")
          && allowedLocation(locationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "active", "deleted", "deletedAt", "deletedBy", "updatedBy", "updatedByName", "updatedAt"
          ]))
        || (canModule("locations", "restore")
          && allowedLocation(locationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "active", "deleted", "deletedAt", "restoredAt", "restoredBy", "updatedBy", "updatedByName", "updatedAt"
          ]))
        || (canModule("locations", "assignDiscounts")
          && allowedLocation(locationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "enabledDiscountIds", "updatedBy", "updatedByName", "updatedAt"
          ]))
        || ((canModule("locations", "loadStock") || canModule("locations", "adjustStock"))
          && allowedLocation(locationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "stockConfiguredAt", "updatedBy", "updatedAt"
          ]));
      allow delete: if false;
    }
    match /products/{productId} {
      allow read: if activeUser()
        && (isAdmin() || canModule("products", "view") || resource.data.active == true);
      allow create: if isAdmin() || canModule("products", "create") || canModule("ecommerce", "edit");
      allow update: if isAdmin() || canModule("products", "edit") || canModule("ecommerce", "edit");
      allow delete: if false;
    }
    match /productCategories/{categoryId} {
      allow read: if activeUser()
        && (isAdmin() || canModule("products", "view") || resource.data.active == true);
      allow create, update: if isAdmin() || canModule("products", "edit") || canModule("ecommerce", "edit");
      allow delete: if false;
    }
    match /discounts/{discountId} {
      allow read: if activeUser() && (isAdmin() || resource.data.active == true);
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /settings/{settingId} {
      allow get: if activeUser();
      allow list, create, update: if isAdmin();
      allow delete: if false;
    }
    match /locationStock/{locationId} {
      allow read, write: if isAdmin();
      match /items/{productId} {
        allow read: if activeUser() && allowedLocation(locationId);
        allow create: if isAdmin()
          || ((canModule("warehouse", "transferStock")
              || canModule("locations", "configureLocationProducts")
              || canModule("locations", "loadStock")
              || canModule("locations", "adjustStock"))
            && allowedLocation(locationId)
            && request.resource.data.productId == productId
            && request.resource.data.currentStock is int
            && request.resource.data.currentStock >= 0);
        allow update: if isAdmin()
          || validSellerStockMutation(locationId, productId)
          || (canModule("warehouse", "transferStock")
            && allowedLocation(locationId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "currentStock", "lastMovementId", "updatedAt", "updatedBy"
            ])
            && request.resource.data.currentStock is int
            && request.resource.data.currentStock >= 0)
          || (canModule("locations", "configureLocationProducts")
            && allowedLocation(locationId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "productId", "productName", "abbreviation", "categoryId", "categoryName",
              "imageUrl", "thumbUrl", "price", "priceMode", "priceOverride",
              "masterDefaultPrice", "yellowAlertQty", "redAlertQty",
              "active", "deleted", "updatedAt", "updatedBy"
            ]))
          || ((canModule("locations", "loadStock") || canModule("locations", "adjustStock"))
            && allowedLocation(locationId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "productId", "productName", "abbreviation", "categoryId", "categoryName",
              "imageUrl", "thumbUrl", "price", "priceMode", "priceOverride",
              "masterDefaultPrice", "initialStock", "currentStock", "lastMovementId",
              "yellowAlertQty", "redAlertQty", "active", "deleted", "deletedAt",
              "productDeleted", "updatedAt", "updatedBy"
            ])
            && request.resource.data.currentStock is int
            && request.resource.data.currentStock >= 0);
        allow delete: if false;
      }
    }
    match /warehouses/{warehouseId} {
      allow read: if canModule("warehouse", "view");
      allow create: if canModule("warehouse", "create") && ownsNewRecord();
      allow update: if canModule("warehouse", "edit")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "description", "address", "active", "deleted", "updatedBy",
          "updatedByName", "updatedAt"
        ]);
      allow delete: if false;
    }
    match /warehouseStock/{warehouseId} {
      allow read, write: if false;
      match /items/{productId} {
        allow read: if canModule("warehouse", "view");
        allow create: if canModule("warehouse", "edit")
          && validWarehouseStock(request.resource.data, productId);
        allow update: if canModule("warehouse", "edit")
          && validWarehouseStock(request.resource.data, productId)
          && request.resource.data.productId == resource.data.productId;
        allow delete: if false;
      }
    }
    match /sales/{saleId} {
      allow get: if isAdmin()
        || (activeUser() && resource.data.sellerId == request.auth.uid)
        || (canModule("quick-sales", "view") && allowedLocation(resource.data.locationId));
      allow list: if isAdmin()
        || (activeUser() && resource.data.sellerId == request.auth.uid)
        || (canModule("quick-sales", "view") && allowedLocation(resource.data.locationId));
      allow create: if isAdmin()
        || (quickSalesPermission("create")
          && activeQuickSalesLocation(request.resource.data.locationId)
          && validSale(request.resource.data));
      allow update: if isAdmin()
        || (quickSalesPermission("edit")
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.locationId == resource.data.locationId
          && resource.data.status == "active"
          && request.resource.data.status in ["active", "cancelled"]
          && ((request.resource.data.status == "active" && activeQuickSalesLocation(resource.data.locationId))
            || (request.resource.data.status == "cancelled" && allowedLocation(resource.data.locationId))));
      allow delete: if false;
    }
    match /stockMovements/{movementId} {
      allow read: if isAdmin()
        || (canModule("warehouse", "view")
          && (("warehouseId" in resource.data) || (("locationId" in resource.data) && allowedLocation(resource.data.locationId))))
        || (canModule("locations", "view")
          && ("locationId" in resource.data)
          && allowedLocation(resource.data.locationId));
      allow create: if signedIn() && validInventoryMovement(request.resource.data);
      allow update, delete: if false;
    }
    match /stockOperations/{operationId} {
      allow get: if activeUser() && (
        !exists(/databases/$(database)/documents/stockOperations/$(operationId))
        || isAdmin()
        || allowedLocation(resource.data.locationId)
      );
      allow list: if isAdmin();
      allow create: if activeUser()
        && request.resource.data.userId == request.auth.uid
        && allowedLocation(request.resource.data.locationId)
        && (canModule("locations", "loadStock") || canModule("locations", "adjustStock") || canModule("warehouse", "edit"));
      allow update, delete: if false;
    }
    match /inventoryOperations/{operationId} {
      allow get: if activeUser() && (
        !exists(/databases/$(database)/documents/inventoryOperations/$(operationId))
        || isAdmin()
        || resource.data.userId == request.auth.uid
        || (resource.data.inventoryType == "location" && allowedLocation(resource.data.inventoryId))
        || (resource.data.inventoryType == "warehouse" && canModule("warehouse", "view"))
      );
      allow list: if isAdmin();
      allow create: if activeUser()
        && request.resource.data.userId == request.auth.uid
        && ((request.resource.data.inventoryType == "location"
            && allowedLocation(request.resource.data.inventoryId)
            && (canModule("locations", "loadStock") || canModule("locations", "configureLocationProducts")))
          || (request.resource.data.inventoryType == "warehouse"
            && canModule("warehouse", "edit")));
      allow update, delete: if false;
    }
    match /stockTransfers/{transferId} {
      allow read: if canModule("warehouse", "view");
      allow create: if canModule("warehouse", "transferStock") && ownsNewRecord();
      allow update: if canModule("warehouse", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /counters/{counterId} {
      allow get: if activeUser();
      allow list: if isAdmin();
      allow create: if signedIn()
        && allowedLocation(request.resource.data.locationId)
        && request.resource.data.lastNumber == 1;
      allow update: if signedIn()
        && allowedLocation(resource.data.locationId)
        && request.resource.data.locationId == resource.data.locationId
        && request.resource.data.lastNumber == resource.data.lastNumber + 1;
      allow delete: if false;
    }
    match /customers/{customerId} {
      allow get: if canModule("loyal-customers", "view")
        || (quickSalesPermission("create") && customerKeyShape(customerId));
      allow list: if canModule("loyal-customers", "view");
      allow create: if ((canModule("loyal-customers", "create") || canModule("loyal-customers", "edit")) && ownsNewRecord())
        || sellerCustomerCreate(customerId);
      allow update: if (canModule("loyal-customers", "edit") && logicalMutation())
        || sellerCustomerUpdate(customerId);
      allow delete: if false;
      match /interactions/{interactionId} {
        allow read: if canModule("loyal-customers", "view");
        allow create, update: if canModule("loyal-customers", "edit");
        allow delete: if false;
      }
    }
    match /customerZones/{zoneId} {
      allow get: if canModule("loyal-customers", "view")
        || (quickSalesPermission("create") && resource.data.active == true);
      allow list: if canModule("loyal-customers", "view")
        || (quickSalesPermission("create") && resource.data.active == true);
      allow create, update: if canModule("loyal-customers", "edit");
      allow delete: if false;
    }
    match /orders/{orderId} {
      allow read: if canModule("ecommerce", "view");
      allow create: if canModule("ecommerce", "create") && ownsNewRecord();
      allow update: if canModule("ecommerce", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /shipments/{shipmentId} {
      allow read: if canModule("shipping", "view");
      allow create: if canModule("shipping", "create") && ownsNewRecord();
      allow update: if canModule("shipping", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /invoices/{invoiceId} {
      allow read: if canModule("finance", "view");
      allow create, update: if canModule("finance", "edit");
      allow delete: if false;
    }
    match /financialEntries/{entryId} {
      allow read: if canModule("finance", "view");
      allow create: if canModule("finance", "create") && ownsNewRecord();
      allow update: if canModule("finance", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /cashSessions/{sessionId} {
      allow read: if canModule("finance", "view");
      allow create, update: if canModule("finance", "edit");
      allow delete: if false;
    }
    match /suppliers/{supplierId} {
      allow read: if canModule("suppliers", "view");
      allow create: if canModule("suppliers", "create") && ownsNewRecord();
      allow update: if canModule("suppliers", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /purchases/{purchaseId} {
      allow read: if canModule("suppliers", "view");
      allow create: if canModule("suppliers", "create") && ownsNewRecord();
      allow update: if canModule("suppliers", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /campaigns/{campaignId} {
      allow read: if canModule("marketing", "view");
      allow create: if canModule("marketing", "create") && ownsNewRecord();
      allow update: if canModule("marketing", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /marketingKnowledge/{documentId} {
      allow get: if documentId == "businessContext" && metaAdsCan("metaAdsView"); allow list: if false;
      allow create: if documentId == "businessContext" && metaAdsCan("metaAdsManageKnowledge") && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid && validBusinessContext(request.resource.data);
      allow update: if documentId == "businessContext" && metaAdsCan("metaAdsManageKnowledge") && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedBy == request.auth.uid && validBusinessContext(request.resource.data); allow delete: if false;
    }
    match /marketingProductProfiles/{productId} {
      allow get: if metaAdsCan("metaAdsView"); allow list: if false;
      allow create: if metaAdsCan("metaAdsManageKnowledge") && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid && validProductMarketing(request.resource.data,productId);
      allow update: if metaAdsCan("metaAdsManageKnowledge") && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.productId == resource.data.productId && request.resource.data.updatedBy == request.auth.uid && validProductMarketing(request.resource.data,productId); allow delete: if false;
    }
    match /metaAdTheories/{theoryId} {
      allow get,list: if metaAdsCan("metaAdsView");
      allow create: if metaAdsCan("metaAdsManageTheory") && request.resource.data.status == "draft" && request.resource.data.latestVersion == 1 && request.resource.data.activeVersion == null && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid && validTheoryParent(request.resource.data);
      allow update: if metaAdsCan("metaAdsManageTheory") && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.schemaVersion == resource.data.schemaVersion && request.resource.data.name == resource.data.name && request.resource.data.description == resource.data.description && request.resource.data.latestVersion >= resource.data.latestVersion && request.resource.data.latestVersion <= resource.data.latestVersion + 1 && request.resource.data.updatedBy == request.auth.uid && validTheoryParent(request.resource.data); allow delete: if false;
      match /versions/{versionId} {
        allow get,list: if metaAdsCan("metaAdsView");
        allow create: if metaAdsCan("metaAdsManageTheory") && request.resource.data.status == "draft" && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid && validTheoryVersion(request.resource.data,theoryId);
        allow update: if metaAdsCan("metaAdsManageTheory") && request.resource.data.schemaVersion == resource.data.schemaVersion && request.resource.data.theoryId == resource.data.theoryId && request.resource.data.version == resource.data.version && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedBy == request.auth.uid && theoryTransition(resource.data.status,request.resource.data.status) && validTheoryVersion(request.resource.data,theoryId); allow delete: if false;
      }
    }
    match /aiUsage/{usageId} { allow get,list: if metaAdsCan("metaAdsManageTheory") || metaAdsCan("metaAdsPlanCampaign"); allow create: if aiUsageCanCreate() && validAiUsage(request.resource.data); allow update,delete: if false; }

    match /metaCampaignProjects/{campaignId} {
      allow get, list: if metaAdsCan("metaAdsView");
      allow create: if metaAdsCreateProjectAllowed();
      allow update: if metaAdsCampaignProjectUpdateAllowed();
      allow delete: if false;
      match /planning/{planningId} {
        allow get: if planningId == "state" && metaAdsCan("metaAdsView"); allow list: if false;
        allow create: if planningId == "state" && metaAdsCan("metaAdsPlanCampaign") && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid && campaignPlanTheoryMatches(request.resource.data,campaignId) && validPlanningState(request.resource.data,campaignId);
        allow update: if planningId == "state" && planningStateUpdateAllowed(campaignId); allow delete: if false;
      }
      match /plans/{planId} {
        allow get,list: if metaAdsCan("metaAdsView");
        allow create: if metaAdsCan("metaAdsPlanCampaign") && request.resource.data.status == "draft" && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid && campaignPlanTheoryMatches(request.resource.data,campaignId) && validCampaignPlanRecord(request.resource.data,campaignId);
        allow update: if request.resource.data.status == "approved" ? campaignPlanApproveAllowed(campaignId) : campaignPlanDraftUpdateAllowed(campaignId); allow delete: if false;
      }
    }
    match /whatsappCampaigns/{campaignId} {
      allow get, list: if whatsappCanView();
      allow create: if whatsappCanCreate()
        && ownsNewRecord()
        && validWhatsappCampaign(request.resource.data);
      allow update: if request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.source == resource.data.source
        && validWhatsappCampaign(request.resource.data)
        && (whatsappCreateCampaignUpdate() || whatsappExtensionCampaignUpdate() || whatsappCancelCampaignUpdate());
      allow delete: if false;
      match /recipients/{recipientId} {
        allow get, list: if whatsappCanView();
        allow create: if whatsappCanCreate()
          && get(/databases/$(database)/documents/whatsappCampaigns/$(campaignId)).data.status == "draft"
          && validWhatsappRecipient(request.resource.data);
        allow update: if whatsappCanSend()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "updatedAt", "errorCode", "errorMessage"
          ])
          && validWhatsappRecipient(request.resource.data);
        allow delete: if whatsappCanCreate()
          && get(/databases/$(database)/documents/whatsappCampaigns/$(campaignId)).data.status == "draft";
      }
      match /events/{eventId} {
        allow get, list: if whatsappCanView();
        allow create: if whatsappCanCreate() || whatsappCanSend() || whatsappCanCancel();
        allow update, delete: if false;
      }
    }
    match /contentItems/{contentId} {
      allow read: if canModule("marketing", "view");
      allow create, update: if canModule("marketing", "edit");
      allow delete: if false;
    }
    match /socialLeads/{leadId} {
      allow read: if canModule("social", "view");
      allow create: if canModule("social", "create") && ownsNewRecord();
      allow update: if canModule("social", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /alerts/{alertId} {
      allow read: if canModule("alerts", "view")
        && (!("responsibleId" in resource.data) || resource.data.responsibleId == request.auth.uid || isAdmin());
      allow create: if canModule("alerts", "create") && ownsNewRecord();
      allow update: if canModule("alerts", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /dailySummaries/{summaryId} {
      allow read: if canModule("metrics", "view");
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /auditLogs/{logId} {
      allow read: if isAdmin()
        || (canModule("locations", "view")
          && ("locationId" in resource.data)
          && allowedLocation(resource.data.locationId))
        || (canModule("warehouse", "view") && ("warehouseId" in resource.data));
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && (isAdmin()
          || (("moduleId" in request.resource.data)
            && request.resource.data.moduleId == "products"
            && (canModule("products", "create") || canModule("products", "edit")))
          || (("moduleId" in request.resource.data)
            && request.resource.data.moduleId == "warehouse"
            && (canModule("warehouse", "create") || canModule("warehouse", "edit") || canModule("warehouse", "transferStock")))
          || (("moduleId" in request.resource.data)
            && request.resource.data.moduleId == "loyal-customers"
            && (canModule("loyal-customers", "create") || canModule("loyal-customers", "edit")))
          || (("moduleId" in request.resource.data)
            && request.resource.data.moduleId == "marketing"
            && (whatsappCanCreate()
              || whatsappCanSend()
              || whatsappCanCancel()
              || metaAdsCan("metaAdsCreateProject")
              || metaAdsCan("metaAdsEditProject")
              || metaAdsCan("metaAdsArchiveProject")
              || metaAdsCan("metaAdsManageKnowledge")
              || metaAdsCan("metaAdsManageTheory")
              || metaAdsCan("metaAdsPlanCampaign")
              || metaAdsCan("metaAdsApprovePlan")
              || canModule("marketing", "edit")))
          || (("locationId" in request.resource.data)
            && allowedLocation(request.resource.data.locationId)));
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}