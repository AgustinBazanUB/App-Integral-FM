    function validWarehouseStock(data, productId) {
      return data.productId == productId
        && data.currentStock is int
        && data.currentStock >= 0
        && !data.keys().hasAny([
          "price", "effectivePrice", "priceMode", "priceOverride", "masterDefaultPrice"
        ]);
    }
    function validInventoryMovement(data) {
      return data.userId == request.auth.uid
        && data.productId is string
        && data.previousStock is int
        && data.previousStock >= 0
        && data.newStock is int
        && data.newStock >= 0
        && data.qty is int
        && data.saleId is string
        && ((data.inventoryType == "warehouse"
            && data.warehouseId is string
            && canModule("warehouse", "edit"))
          || (data.inventoryType == "location"
            && data.locationId is string
            && allowedLocation(data.locationId)
            && (canModule("locations", "loadStock")
              || canModule("locations", "configureLocationProducts")
              || canModule("warehouse", "transferStock")))
          || (data.locationId is string
            && allowedLocation(data.locationId)
            && quickSalesPermission("edit")));
