rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function activeUser() {
      let user = profile();
      return signedIn() && user.active == true;
    }
    function adminRole() {
      let user = profile();
      return (
        user.role == "admin"
        || user.role == "general_admin"
        || (("canAccessAdmin" in user) && user.canAccessAdmin == true)
        || (("isAdmin" in user) && user.isAdmin == true)
        || (("roles" in user) && ("admin" in user.roles))
      );
    }
    function isAdmin() { return activeUser() && adminRole(); }
    function explicitPermission(moduleId, action) {
      let user = profile();
      return ("permissions" in user)
        && (moduleId in user.permissions)
        && (user.permissions[moduleId] is list)
        && (action in user.permissions[moduleId] || "admin" in user.permissions[moduleId]);
    }
    function roleModule(moduleId) {
      let role = profile().role;
      return (
        (role == "seller" && moduleId in ["locations", "quick-sales", "alerts"])
        || (role == "location_manager" && moduleId in ["locations", "quick-sales", "metrics", "alerts"])
        || (role == "warehouse_manager" && moduleId in ["locations", "warehouse", "suppliers", "alerts"])
        || (role == "marketing_manager" && moduleId in ["loyal-customers", "social", "marketing", "metrics"])
        || (role == "ecommerce_manager" && moduleId in ["ecommerce", "shipping", "loyal-customers", "metrics"])
        || (role == "shipping_manager" && moduleId in ["shipping", "alerts"])
        || (role == "supplier_manager" && moduleId in ["suppliers", "warehouse", "finance"])
        || (role == "financial_manager" && moduleId in ["finance", "metrics"])
        || (role == "analyst" && moduleId == "metrics")
        || (role == "operational_admin" && moduleId != "finance")
      );
    }
    function rolePermission(moduleId, action) {
      let role = profile().role;
      return (
        (action == "view" && roleModule(moduleId))
        || (role == "seller"
          && ((moduleId == "quick-sales" && action in ["create", "edit"])
            || (moduleId == "alerts" && action == "edit")))
        || (role == "location_manager"
          && ((moduleId == "locations"
              && action in [
                "create", "edit", "export", "approve", "viewLocationProducts",
                "configureLocationProducts", "viewStock", "loadStock", "adjustStock"
              ])
            || (moduleId in ["quick-sales", "alerts"]
              && action in ["create", "edit", "export", "approve"])))
        || (role == "warehouse_manager"
          && ((moduleId == "locations" && action == "viewAllLocations")
            || (moduleId in ["warehouse", "suppliers", "alerts"]
              && action in ["create", "edit", "export", "approve", "transferStock"])))
        || (role == "marketing_manager"
          && moduleId in ["social", "marketing"]
          && action in [
            "create", "edit", "export",
            "whatsappView", "whatsappCreateCampaign", "whatsappSendToExtension",
            "whatsappCancelCampaign", "whatsappViewHistory", "whatsappImportExcel",
            "metaAdsView", "metaAdsCreateProject", "metaAdsEditProject", "metaAdsArchiveProject",
            "metaAdsManageKnowledge", "metaAdsManageTheory"
          ])
        || (role == "ecommerce_manager"
          && moduleId in ["ecommerce", "shipping", "loyal-customers"]
          && action in ["create", "edit", "export"])
        || (role == "shipping_manager"
          && moduleId in ["shipping", "alerts"]
          && action in ["create", "edit", "export"])
        || (role == "supplier_manager"
          && moduleId in ["suppliers", "warehouse"]
          && action in ["create", "edit", "export", "approve", "transferStock"])
        || (role == "financial_manager"
          && moduleId == "finance"
          && action in ["create", "edit", "export", "approve"])
        || (role == "analyst" && moduleId == "metrics" && action == "export")
        || (role == "operational_admin"
          && moduleId != "finance"
          && action in [
            "create", "edit", "export", "approve", "viewAllLocations",
            "viewLocationProducts", "configureLocationProducts", "viewStock",
            "loadStock", "adjustStock", "assignDiscounts", "transferStock",
            "whatsappView", "whatsappCreateCampaign", "whatsappSendToExtension",
            "whatsappCancelCampaign", "whatsappViewHistory", "whatsappImportExcel"
          ])
      );
    }
    function canModule(moduleId, action) {
      return activeUser()
        && (adminRole() || explicitPermission(moduleId, action) || rolePermission(moduleId, action));
    }
    function allowedLocation(locationId) {
      let user = profile();
      return signedIn() && user.active == true && (
        user.role in ["admin", "general_admin", "operational_admin", "warehouse_manager"]
        || (("canAccessAdmin" in user) && user.canAccessAdmin == true)
        || (("isAdmin" in user) && user.isAdmin == true)
        || (("roles" in user) && ("admin" in user.roles))
        || (("permissions" in user)
          && ("locations" in user.permissions)
          && (user.permissions.locations is list)
          && ("viewAllLocations" in user.permissions.locations || "admin" in user.permissions.locations))
        || (("allowedLocationIds" in user) && locationId in user.allowedLocationIds)
      );
    }
    function quickSalesPermission(action) {
      let user = profile();
      return signedIn() && user.active == true && (
        user.role in ["admin", "general_admin", "operational_admin"]
        || (("canAccessAdmin" in user) && user.canAccessAdmin == true)
        || (("isAdmin" in user) && user.isAdmin == true)
        || (("roles" in user) && ("admin" in user.roles))
        || (user.role in ["seller", "location_manager"] && action in ["view", "create", "edit"])
        || (("permissions" in user)
          && ("quick-sales" in user.permissions)
          && (user.permissions["quick-sales"] is list)
          && (action in user.permissions["quick-sales"] || "admin" in user.permissions["quick-sales"]))
      );
    }
    function locationNotDeleted(location) {
      return !("deleted" in location) || location.deleted != true;
    }
    function locationNotPaused(location) {
      return !("manualInactiveUntil" in location)
        || location.manualInactiveUntil == null
        || location.manualInactiveUntil <= request.time;
    }
    function locationScheduleStarted(location) {
      return !("scheduleStartAt" in location)
        || location.scheduleStartAt == null
        || location.scheduleStartAt <= request.time;
    }
    function locationScheduleNotEnded(location) {
      return !("scheduleEndAt" in location)
        || location.scheduleEndAt == null
        || location.scheduleEndAt >= request.time;
    }
    function activeAllowedLocation(locationId) {
      let location = get(/databases/$(database)/documents/locations/$(locationId)).data;
      return allowedLocation(locationId)
        && locationNotDeleted(location)
        && locationNotPaused(location)
        && locationScheduleStarted(location)
        && locationScheduleNotEnded(location)
        && location.active == true;
    }
    function activeQuickSalesLocation(locationId) {
      let location = get(/databases/$(database)/documents/locations/$(locationId)).data;
      return allowedLocation(locationId)
        && locationNotDeleted(location)
        && locationNotPaused(location)
        && locationScheduleStarted(location)
        && locationScheduleNotEnded(location)
        && location.active == true;
    }
    function validPaymentPart(part) {
      return part is map
        && part.keys().hasOnly(["method", "label", "amount"])
        && part.method in ["credit", "debit", "alias", "cash"]
        && part.amount is int
        && part.amount > 0;
    }
    function validSinglePayment(data) {
      return data.paymentMethod in ["credit", "debit", "alias", "cash"]
        && data.paymentMethodLabel is string;
    }
    function validMultiplePayment(data) {
      let size = data.payments.size();
      return data.paymentMethod == "multiple"
        && data.payments is list
        && size >= 2
        && size <= 4
        && validPaymentPart(data.payments[0])
        && validPaymentPart(data.payments[1])
        && (size < 3 || validPaymentPart(data.payments[2]))
        && (size < 4 || validPaymentPart(data.payments[3]));
    }
    function validSale(data) {
      return data.sellerId == request.auth.uid
        && data.locationId is string
        && data.status == "active"
        && data.total is int
        && data.total >= 0
        && data.items is list
        && data.items.size() > 0
        && (validSinglePayment(data) || validMultiplePayment(data));
    }
    function linkedSellerStockMutation(locationId, productId) {
      let sale = getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastSaleId)).data;
      let movementPath = /databases/$(database)/documents/stockMovements/$(request.resource.data.lastMovementId);
      let movement = getAfter(movementPath).data;
      return !exists(movementPath)
        && existsAfter(movementPath)
        && sale.sellerId == request.auth.uid
        && sale.locationId == locationId
        && sale.status in ["active", "cancelled"]
        && movement.userId == request.auth.uid
        && movement.locationId == locationId
        && movement.productId == productId
        && movement.saleId == request.resource.data.lastSaleId
        && movement.previousStock == resource.data.currentStock
        && movement.newStock == request.resource.data.currentStock;
    }
    function validSellerStockMutation(locationId, productId) {
      return quickSalesPermission("edit")
        && allowedLocation(locationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "currentStock", "lastSaleId", "lastMovementId", "updatedAt"
        ])
        && request.resource.data.currentStock is int
        && request.resource.data.currentStock >= 0
        && request.resource.data.lastSaleId is string
        && request.resource.data.lastMovementId is string
        && linkedSellerStockMutation(locationId, productId);
    }
    function ownsNewRecord() {
      return request.resource.data.createdBy == request.auth.uid;
    }
    function logicalMutation() {
      return !("deleted" in request.resource.data)
        || request.resource.data.deleted is bool;
    }
    function customerKeyShape(customerId) {
      return customerId is string
        && customerId.size() == 49
        && customerId.matches('customer_[0-9a-f]+');
    }
    function linkedSellerCustomer(customerId) {
      let saleId = request.resource.data.lastSaleId;
      let salePath = /databases/$(database)/documents/sales/$(saleId);
      let sale = getAfter(salePath).data;
      return saleId is string
        && existsAfter(salePath)
        && sale.sellerId == request.auth.uid
        && sale.customerId == customerId
        && sale.status == "active"
        && allowedLocation(sale.locationId);
    }
    function sellerCustomerCreate(customerId) {
      return quickSalesPermission("create")
        && customerKeyShape(customerId)
        && request.resource.data.customerKey == customerId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.source == "seller_sale"
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phoneNormalized is string
        && request.resource.data.phoneNormalized.size() >= 8
        && request.resource.data.phoneNormalized.size() <= 11
        && request.resource.data.zoneName is string
        && request.resource.data.zoneName.size() > 0
        && request.resource.data.active == true
        && request.resource.data.deleted == false
        && linkedSellerCustomer(customerId);
    }
    function sellerCustomerUpdate(customerId) {
      return quickSalesPermission("create")
        && customerKeyShape(customerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastSaleId", "lastPurchaseAt", "updatedAt"
        ])
        && linkedSellerCustomer(customerId);
    }
    function whatsappDenied(action) {
      let user = profile();
      return ("permissionDeny" in user)
        && ("marketing" in user.permissionDeny)
        && (user.permissionDeny.marketing is list)
        && action in user.permissionDeny.marketing;
    }
    function whatsappCanView() {
      return activeUser() && (
        (!whatsappDenied("whatsappView") && canModule("marketing", "whatsappView"))
        || (!whatsappDenied("whatsappViewHistory") && canModule("marketing", "whatsappViewHistory"))
      );
    }
    function whatsappCanCreate() {
      return activeUser()
        && !whatsappDenied("whatsappCreateCampaign")
        && canModule("marketing", "whatsappCreateCampaign");
    }
    function whatsappCanSend() {
      return activeUser()
        && !whatsappDenied("whatsappSendToExtension")
        && canModule("marketing", "whatsappSendToExtension");
    }
    function whatsappCanCancel() {
      return activeUser()
        && !whatsappDenied("whatsappCancelCampaign")
        && canModule("marketing", "whatsappCancelCampaign");
    }
    function whatsappStatus(value) {
      return value in ["draft", "ready", "running", "paused", "completed", "error", "cancelled"];
    }
    function noWhatsappSecrets(data) {
      return !data.keys().hasAny([
        "cookies", "cookie", "whatsappToken", "token", "password", "qr",
        "localStorage", "imageData", "imageBase64", "binaryImages", "filePath",
        "selectors", "retryDelay", "batchDelay", "messageDelay"
      ]);
    }
    function validWhatsappCampaign(data) {
      return data.name is string
        && data.name.size() > 0
        && whatsappStatus(data.status)
        && data.totalRecipients is int
        && data.totalRecipients >= 0
        && data.sentCount is int
        && data.sentCount >= 0
        && data.sentCount <= data.totalRecipients
        && data.errorCount is int
        && data.errorCount >= 0
        && data.imageCount is int
        && data.imageCount >= 0
        && data.imageCount <= 3
        && noWhatsappSecrets(data);
    }
    function validWhatsappRecipient(data) {
      return data.recipientId is string
        && data.phoneNormalized is string
        && data.phoneNormalized.size() >= 8
        && data.phoneNormalized.size() <= 11
        && data.source in ["flor_mia", "excel"]
        && data.status in ["pending", "running", "completed", "error"]
        && !data.keys().hasAny(["cookies", "token", "password", "imageData", "imageBase64"]);
    }
    function whatsappCreateCampaignUpdate() {
      return whatsappCanCreate()
        && request.resource.data.status in ["draft", "ready"]
        && request.resource.data.sentCount == 0
        && request.resource.data.errorCount == 0
        && request.resource.data.progressPercentage == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "filters", "message", "imageCount", "imageNames", "imageOrder",
          "imageMetadata", "totalRecipients", "sentCount", "errorCount",
          "progressPercentage", "status", "snapshotState", "preparedAt",
          "updatedBy", "updatedByName", "updatedAt"
        ]);
    }
    function whatsappExtensionCampaignUpdate() {
      return whatsappCanSend()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "sentCount", "errorCount", "progressPercentage",
          "lastExtensionSequence", "lastExtensionUpdateAt", "startedAt", "finishedAt",
          "extensionErrorCode", "extensionErrorMessage", "deliveredToExtensionAt",
          "cancelledAt", "cancelledBy", "updatedBy", "updatedByName", "updatedAt"
        ]);
    }
    function whatsappCancelCampaignUpdate() {
      return whatsappCanCancel()
        && request.resource.data.status == "cancelled"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "cancelledAt", "cancelledBy", "finishedAt", "updatedAt"
        ]);
    }
    function metaAdsDenied(action) {
      let user = profile();
      return ("permissionDeny" in user)
        && ("marketing" in user.permissionDeny)
        && (user.permissionDeny.marketing is list)
        && action in user.permissionDeny.marketing;
    }
    function metaAdsExplicit(action) {
      let user = profile();
      return ("permissions" in user) && ("marketing" in user.permissions) && (
        ((user.permissions.marketing is list) && (action in user.permissions.marketing || "admin" in user.permissions.marketing))
        || ((user.permissions.marketing is map) && (((action in user.permissions.marketing) && user.permissions.marketing[action] == true) || (("admin" in user.permissions.marketing) && user.permissions.marketing.admin == true)))
      );
    }
    function metaAdsAllowed(action) {
      let user = profile();
      return ("permissionAllow" in user) && ("marketing" in user.permissionAllow) && (user.permissionAllow.marketing is list) && action in user.permissionAllow.marketing;
    }
    function metaAdsRoleCan(action) {
      return profile().role == "marketing_manager" && action in [
        "metaAdsView", "metaAdsCreateProject", "metaAdsEditProject", "metaAdsArchiveProject",
        "metaAdsManageKnowledge", "metaAdsManageTheory",
        "metaAdsPlanCampaign", "metaAdsApprovePlan"
      ];
    }
    function metaAdsCan(action) {
      return activeUser() && !metaAdsDenied(action)
        && (adminRole() || metaAdsExplicit(action) || metaAdsAllowed(action) || metaAdsRoleCan(action));
    }

    function validKnowledgeList(v) { return v is list && v.size() <= 50; }
    function validBusinessContext(d) {
      return d.keys().hasOnly(["schemaVersion","brandDescription","positioning","history","differentiators","channels","characteristics","policies","promotions","brandArguments","createdBy","createdByName","createdAt","updatedBy","updatedByName","updatedAt"])
        && d.schemaVersion == 1 && d.brandDescription is string && d.brandDescription.size() <= 5000 && d.positioning is string && d.positioning.size() <= 5000 && d.history is string && d.history.size() <= 5000
        && validKnowledgeList(d.differentiators) && validKnowledgeList(d.channels) && validKnowledgeList(d.characteristics) && validKnowledgeList(d.policies) && validKnowledgeList(d.promotions) && validKnowledgeList(d.brandArguments)
        && d.createdBy is string && d.createdAt is timestamp && d.updatedBy is string && d.updatedAt is timestamp;
    }
    function validProductMarketing(d, productId) {
      return d.keys().hasOnly(["schemaVersion","productId","benefits","objections","differentiators","origin","uses","arguments","marketingNotes","createdBy","createdByName","createdAt","updatedBy","updatedByName","updatedAt"])
        && d.schemaVersion == 1 && d.productId == productId && productId.size() > 0 && productId.size() <= 128 && exists(/databases/$(database)/documents/products/$(productId))
        && validKnowledgeList(d.benefits) && validKnowledgeList(d.objections) && validKnowledgeList(d.differentiators) && d.origin is string && d.origin.size() <= 500 && validKnowledgeList(d.uses) && validKnowledgeList(d.arguments) && d.marketingNotes is string && d.marketingNotes.size() <= 4000
        && d.createdBy is string && d.createdAt is timestamp && d.updatedBy is string && d.updatedAt is timestamp;
    }
    function validTheoryStatus(v) { return v in ["draft","compiling","review","approved","active","archived","error"]; }
    // TheoryConfig deep validation lives in theorySchema.js and the backend.
    // Firestore keeps a bounded structural envelope so valid writes stay below
    // the platform's 1000-expression evaluation budget.
    function validQuestionPolicy(q) {
      return q is map
        && q.keys().hasAll(["mode", "instructions", "requiredFields"])
        && q.keys().hasOnly(["mode", "instructions", "requiredFields"])
        && q.mode in ["minimal", "guided", "custom"]
        && q.instructions is string && q.instructions.size() <= 4000
        && q.requiredFields is list && q.requiredFields.size() <= 50;
    }
    function validTheoryMetadata(m) {
      return m is map
        && m.keys().hasAll(["compilerNotes"])
        && m.keys().hasOnly(["compilerNotes"])
        && m.compilerNotes is string && m.compilerNotes.size() <= 4000;
    }
    function validTheoryConfig(c) {
      return c is map
        && c.keys().hasAll(["schemaVersion", "platform", "name", "description", "campaignRules", "creativeRequirements", "validationRules", "questionPolicy", "testingRules", "recommendationRules", "metadata"])
        && c.keys().hasOnly(["schemaVersion", "platform", "name", "description", "campaignRules", "creativeRequirements", "validationRules", "questionPolicy", "testingRules", "recommendationRules", "metadata"])
        && c.schemaVersion == 1
        && c.platform is string && c.platform.size() > 0 && c.platform.size() <= 64
        && c.name is string && c.name.size() > 0 && c.name.size() <= 120
        && c.description is string && c.description.size() <= 4000
        && c.campaignRules is list && c.campaignRules.size() <= 20
        && c.creativeRequirements is list && c.creativeRequirements.size() <= 20
        && c.validationRules is list && c.validationRules.size() <= 20
        && validQuestionPolicy(c.questionPolicy)
        && c.testingRules is list && c.testingRules.size() <= 20
        && c.recommendationRules is list && c.recommendationRules.size() <= 20
        && validTheoryMetadata(c.metadata);
    }
    function validTheoryParent(d) {
      return d.keys().hasOnly(["schemaVersion","name","description","status","latestVersion","latestVersionId","activeVersion","activeVersionId","createdBy","createdByName","createdAt","updatedBy","updatedByName","updatedAt"]) && d.schemaVersion == 1 && d.name is string && d.name.size() > 0 && d.name.size() <= 120 && d.description is string && validTheoryStatus(d.status) && d.latestVersion is int && d.latestVersion >= 1 && d.latestVersionId is string && (d.activeVersion == null || (d.activeVersion is int && d.activeVersion >= 1)) && (d.activeVersionId == null || d.activeVersionId is string) && d.createdBy is string && d.createdAt is timestamp && d.updatedBy is string && d.updatedAt is timestamp;
    }
    function validSourceMeta(m) { return m is map && m.keys().hasOnly(["sourceType","sourceName","sourceHash","sourceSize","sourceCharacterCount"]) && m.sourceType in ["text","markdown","pdf","editor"] && m.sourceName is string && (m.sourceHash == null || m.sourceHash is string) && (m.sourceSize == null || (m.sourceSize is int && m.sourceSize >= 0 && m.sourceSize <= 3000000)) && m.sourceCharacterCount is int && m.sourceCharacterCount > 0 && m.sourceCharacterCount <= 60000; }
    function validCompilerMeta(m) { return m == null || (m is map && m.keys().hasOnly(["provider","operation","model","responseId","inputTokens","outputTokens","totalTokens","actualCostUsd","compilerVersion"]) && m.provider == "openai" && m.operation == "theory_compile" && m.model is string && m.inputTokens is int && m.inputTokens >= 0 && m.outputTokens is int && m.outputTokens >= 0 && m.totalTokens is int && m.totalTokens >= 0 && (m.actualCostUsd == null || (m.actualCostUsd is number && m.actualCostUsd >= 0))); }
    function validTheoryVersion(d,theoryId) {
      return d.keys().hasOnly(["schemaVersion","theoryId","version","status","config","sourceText","sourceMetadata","compilerMetadata","compileError","derivedFromVersionId","createdBy","createdByName","createdAt","updatedBy","updatedByName","updatedAt","approvedBy","approvedByName","approvedAt","activatedBy","activatedByName","activatedAt"]) && d.schemaVersion == 1 && d.theoryId == theoryId && d.version is int && d.version >= 1 && validTheoryStatus(d.status) && (d.config == null || validTheoryConfig(d.config)) && d.sourceText is string && d.sourceText.size() > 0 && d.sourceText.size() <= 60000 && validSourceMeta(d.sourceMetadata) && validCompilerMeta(d.compilerMetadata) && d.createdBy is string && d.createdAt is timestamp && d.updatedBy is string && d.updatedAt is timestamp;
    }
    function theoryTransition(a,b) { return (a == "draft" && b in ["draft","compiling"]) || (a == "compiling" && b in ["review","error"]) || (a == "review" && b in ["review","compiling","approved"]) || (a == "error" && b in ["draft","compiling"]) || (a == "approved" && b == "active") || (a == "active" && b == "archived") || (a == "archived" && b == "active"); }
    function validAiUsage(d) {
      let theoryOperation = d.operation == "theory_compile";
      let campaignOperation = d.operation in ["campaign_questions", "campaign_plan"];
      return d.keys().hasOnly(["schemaVersion","operation","theoryId","theoryVersionId","campaignId","userId","userName","model","inputTokens","outputTokens","totalTokens","actualCostUsd","success","errorCode","responseId","createdAt"])
        && d.schemaVersion == 1 && (theoryOperation || campaignOperation) && d.userId == request.auth.uid
        && d.model is string && d.inputTokens is int && d.inputTokens >= 0 && d.outputTokens is int && d.outputTokens >= 0
        && d.totalTokens is int && d.totalTokens >= 0 && (d.actualCostUsd == null || (d.actualCostUsd is number && d.actualCostUsd >= 0))
        && d.success is bool && d.createdAt is timestamp
        && ((theoryOperation && d.theoryId is string && d.theoryVersionId is string)
          || (campaignOperation && d.campaignId is string && d.campaignId.size() > 0 && d.campaignId.size() <= 128));
    }
    function aiUsageCanCreate() {
      return (request.resource.data.operation == "theory_compile" && metaAdsCan("metaAdsManageTheory"))
        || (request.resource.data.operation in ["campaign_questions", "campaign_plan"] && metaAdsCan("metaAdsPlanCampaign"));
    }

    function validMetaAdsStatus(value) {
      return value in [
        "draft", "planning", "creative", "validation", "rendering", "ready",
        "publishing", "active", "paused", "completed", "error", "archived"
      ];
    }
    function validMetaAdsProduct(data) {
      return (data.productId == null && data.productNameSnapshot == null)
        || (data.productId is string
          && data.productId.size() > 0
          && data.productId.size() <= 128
          && data.productNameSnapshot is string
          && data.productNameSnapshot.size() > 0
          && data.productNameSnapshot.size() <= 180);
    }
    function validMetaAdsPlanningFields(data) {
      let fields = ["planningStatus","theoryId","theoryVersionId","theoryVersion","theoryNameSnapshot","latestPlanRevision","approvedPlanRevision","lastPlanningAt","lastPlanningBy"];
      return !data.keys().hasAny(fields)
        || (data.keys().hasAll(fields)
          && data.planningStatus in ["context_ready","questions_ready","answers_ready","plan_ready","approved"]
          && data.theoryId is string && data.theoryId.size() > 0 && data.theoryId.size() <= 128
          && data.theoryVersionId is string && data.theoryVersionId.size() > 0 && data.theoryVersionId.size() <= 128
          && data.theoryVersion is int && data.theoryVersion >= 1
          && data.theoryNameSnapshot is string && data.theoryNameSnapshot.size() > 0 && data.theoryNameSnapshot.size() <= 120
          && data.latestPlanRevision is int && data.latestPlanRevision >= 0
          && (data.approvedPlanRevision == null || (data.approvedPlanRevision is int && data.approvedPlanRevision >= 1 && data.approvedPlanRevision <= data.latestPlanRevision))
          && data.lastPlanningAt is timestamp && data.lastPlanningBy is string && data.lastPlanningBy.size() > 0);
    }
    function validMetaAdsCampaignProject(data) {
      return data.keys().hasOnly(["name","channel","status","schemaVersion","productId","productNameSnapshot","archived","createdBy","createdByName","createdAt","updatedBy","updatedByName","updatedAt","archivedAt","archivedBy","archivedByName","planningStatus","theoryId","theoryVersionId","theoryVersion","theoryNameSnapshot","latestPlanRevision","approvedPlanRevision","lastPlanningAt","lastPlanningBy"])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120 && data.channel == "meta_ads" && data.schemaVersion == 1
        && validMetaAdsStatus(data.status) && data.archived is bool && data.archived == (data.status == "archived")
        && validMetaAdsProduct(data) && validMetaAdsPlanningFields(data)
        && data.createdBy is string && data.createdBy.size() > 0 && data.createdByName is string && data.createdByName.size() > 0 && data.createdAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedByName is string && data.updatedByName.size() > 0 && data.updatedAt is timestamp
        && ((data.status == "archived" && ("archivedAt" in data) && data.archivedAt is timestamp && ("archivedBy" in data) && data.archivedBy is string && data.archivedBy.size() > 0 && ("archivedByName" in data) && data.archivedByName is string && data.archivedByName.size() > 0)
          || (data.status != "archived" && !data.keys().hasAny(["archivedAt","archivedBy","archivedByName"])));
    }
    function metaAdsPlanningTheoryActive(data) {
      let theoryPath = /databases/$(database)/documents/metaAdTheories/$(data.theoryId)/versions/$(data.theoryVersionId);
      return exists(theoryPath) && get(theoryPath).data.status == "active" && get(theoryPath).data.version == data.theoryVersion;
    }
    function metaAdsPlanningIdentityStable() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.channel == resource.data.channel
        && request.resource.data.schemaVersion == resource.data.schemaVersion;
    }
    function metaAdsPlanProjectAllowedCompact(changed) {
      return metaAdsCan("metaAdsPlanCampaign")
        && metaAdsPlanningIdentityStable()
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.archived == false
        && validMetaAdsCampaignProject(request.resource.data)
        && (resource.data.status == "draft"
          ? (request.resource.data.status == "planning"
