rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function activeUser() {
      let user = profile();
      return signedIn() && user.active == true;
    }
    function adminRole() {
      let user = profile();
      return (
        user.role == "admin"
        || user.role == "general_admin"
        || (("canAccessAdmin" in user) && user.canAccessAdmin == true)
        || (("isAdmin" in user) && user.isAdmin == true)
        || (("roles" in user) && ("admin" in user.roles))
      );
    }
    function isAdmin() { return activeUser() && adminRole(); }
    function explicitPermission(moduleId, action) {
      let user = profile();
      return ("permissions" in user)
        && (moduleId in user.permissions)
        && (user.permissions[moduleId] is list)
        && (action in user.permissions[moduleId] || "admin" in user.permissions[moduleId]);
    }
    function roleModule(moduleId) {
      let role = profile().role;
      return (
        (role == "seller" && moduleId in ["locations", "quick-sales", "alerts"])
        || (role == "location_manager" && moduleId in ["locations", "quick-sales", "metrics", "alerts"])
        || (role == "warehouse_manager" && moduleId in ["locations", "warehouse", "suppliers", "alerts"])
        || (role == "marketing_manager" && moduleId in ["loyal-customers", "social", "marketing", "metrics"])
        || (role == "ecommerce_manager" && moduleId in ["ecommerce", "shipping", "loyal-customers", "metrics"])
        || (role == "shipping_manager" && moduleId in ["shipping", "alerts"])
        || (role == "supplier_manager" && moduleId in ["suppliers", "warehouse", "finance"])
        || (role == "financial_manager" && moduleId in ["finance", "metrics"])
        || (role == "analyst" && moduleId == "metrics")
        || (role == "operational_admin" && moduleId != "finance")
      );
    }
    function rolePermission(moduleId, action) {
      let role = profile().role;
      return (
        (action == "view" && roleModule(moduleId))
        || (role == "seller"
          && ((moduleId == "quick-sales" && action in ["create", "edit"])
            || (moduleId == "alerts" && action == "edit")))
        || (role == "location_manager"
          && ((moduleId == "locations"
              && action in [
                "create", "edit", "export", "approve", "viewLocationProducts",
                "configureLocationProducts", "viewStock", "loadStock", "adjustStock"
              ])
            || (moduleId in ["quick-sales", "alerts"]
              && action in ["create", "edit", "export", "approve"])))
        || (role == "warehouse_manager"
          && moduleId in ["warehouse", "suppliers", "alerts"]
          && action in ["create", "edit", "export", "approve"])
        || (role == "marketing_manager"
          && moduleId in ["social", "marketing"]
          && action in ["create", "edit", "export"])
        || (role == "ecommerce_manager"
          && moduleId in ["ecommerce", "shipping", "loyal-customers"]
          && action in ["create", "edit", "export"])
        || (role == "shipping_manager"
          && moduleId in ["shipping", "alerts"]
          && action in ["create", "edit", "export"])
        || (role == "supplier_manager"
          && moduleId in ["suppliers", "warehouse"]
          && action in ["create", "edit", "export", "approve"])
        || (role == "financial_manager"
          && moduleId == "finance"
          && action in ["create", "edit", "export", "approve"])
        || (role == "analyst" && moduleId == "metrics" && action == "export")
        || (role == "operational_admin"
          && moduleId != "finance"
          && action in [
            "create", "edit", "export", "approve", "viewAllLocations",
            "viewLocationProducts", "configureLocationProducts", "viewStock",
            "loadStock", "adjustStock", "assignDiscounts"
          ])
      );
    }
    function canModule(moduleId, action) {
      return activeUser()
        && (adminRole() || explicitPermission(moduleId, action) || rolePermission(moduleId, action));
    }
    function allowedLocation(locationId) {
      let user = profile();
      return signedIn() && user.active == true && (
        user.role in ["admin", "general_admin", "operational_admin"]
        || (("canAccessAdmin" in user) && user.canAccessAdmin == true)
        || (("isAdmin" in user) && user.isAdmin == true)
        || (("roles" in user) && ("admin" in user.roles))
        || (("permissions" in user)
          && ("locations" in user.permissions)
          && (user.permissions.locations is list)
          && ("viewAllLocations" in user.permissions.locations || "admin" in user.permissions.locations))
        || (("allowedLocationIds" in user) && locationId in user.allowedLocationIds)
      );
    }
    function quickSalesPermission(action) {
      let user = profile();
      return signedIn() && user.active == true && (
        user.role in ["admin", "general_admin", "operational_admin"]
        || (("canAccessAdmin" in user) && user.canAccessAdmin == true)
        || (("isAdmin" in user) && user.isAdmin == true)
        || (("roles" in user) && ("admin" in user.roles))
        || (user.role in ["seller", "location_manager"] && action in ["view", "create", "edit"])
        || (("permissions" in user)
          && ("quick-sales" in user.permissions)
          && (user.permissions["quick-sales"] is list)
          && (action in user.permissions["quick-sales"] || "admin" in user.permissions["quick-sales"]))
      );
    }
    function locationNotDeleted(location) {
      return !("deleted" in location) || location.deleted != true;
    }
    function locationNotPaused(location) {
      return !("manualInactiveUntil" in location)
        || location.manualInactiveUntil == null
        || location.manualInactiveUntil <= request.time;
    }
    function locationScheduleStarted(location) {
      return !("scheduleStartAt" in location)
        || location.scheduleStartAt == null
        || location.scheduleStartAt <= request.time;
    }
    function locationScheduleNotEnded(location) {
      return !("scheduleEndAt" in location)
        || location.scheduleEndAt == null
        || location.scheduleEndAt >= request.time;
    }
    function activeAllowedLocation(locationId) {
      let location = get(/databases/$(database)/documents/locations/$(locationId)).data;
      return allowedLocation(locationId)
        && locationNotDeleted(location)
        && locationNotPaused(location)
        && locationScheduleStarted(location)
        && locationScheduleNotEnded(location)
        && location.active == true;
    }
    function activeQuickSalesLocation(locationId) {
      let location = get(/databases/$(database)/documents/locations/$(locationId)).data;
      return allowedLocation(locationId)
        && locationNotDeleted(location)
        && locationNotPaused(location)
        && locationScheduleStarted(location)
        && locationScheduleNotEnded(location)
        && location.active == true;
    }
    function validPaymentPart(part) {
      return part is map
        && part.keys().hasOnly(["method", "label", "amount"])
        && part.method in ["credit", "debit", "alias", "cash"]
        && part.amount is int
        && part.amount > 0;
    }
    function validSinglePayment(data) {
      return data.paymentMethod in ["credit", "debit", "alias", "cash"]
        && data.paymentMethodLabel is string;
    }
    function validMultiplePayment(data) {
      let size = data.payments.size();
      return data.paymentMethod == "multiple"
        && data.payments is list
        && size >= 2
        && size <= 4
        && validPaymentPart(data.payments[0])
        && validPaymentPart(data.payments[1])
        && (size < 3 || validPaymentPart(data.payments[2]))
        && (size < 4 || validPaymentPart(data.payments[3]));
    }
    function validSale(data) {
      return data.sellerId == request.auth.uid
        && data.locationId is string
        && data.status == "active"
        && data.total is int
        && data.total >= 0
        && data.items is list
        && data.items.size() > 0
        && (validSinglePayment(data) || validMultiplePayment(data));
    }
    function linkedSellerStockMutation(locationId, productId) {
      let sale = getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastSaleId)).data;
      let movementPath = /databases/$(database)/documents/stockMovements/$(request.resource.data.lastMovementId);
      let movement = getAfter(movementPath).data;
      return !exists(movementPath)
        && existsAfter(movementPath)
        && sale.sellerId == request.auth.uid
        && sale.locationId == locationId
        && sale.status in ["active", "cancelled"]
        && movement.userId == request.auth.uid
        && movement.locationId == locationId
        && movement.productId == productId
        && movement.saleId == request.resource.data.lastSaleId
        && movement.previousStock == resource.data.currentStock
        && movement.newStock == request.resource.data.currentStock;
    }
    function validSellerStockMutation(locationId, productId) {
      return quickSalesPermission("edit")
        && allowedLocation(locationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "currentStock", "lastSaleId", "lastMovementId", "updatedAt"
        ])
        && request.resource.data.currentStock is int
        && request.resource.data.currentStock >= 0
        && request.resource.data.lastSaleId is string
        && request.resource.data.lastMovementId is string
        && linkedSellerStockMutation(locationId, productId);
    }
    function ownsNewRecord() {
      return request.resource.data.createdBy == request.auth.uid;
    }
    function logicalMutation() {
      return !("deleted" in request.resource.data)
        || request.resource.data.deleted is bool;
    }

    match /users/{uid} {
      allow get: if isAdmin() || (activeUser() && request.auth.uid == uid);
      allow list, create, update: if isAdmin();
      allow delete: if false;
    }
    match /roles/{roleId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }
    match /permissions/{permissionId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }
    match /locations/{locationId} {
      allow read: if isAdmin() || (canModule("locations", "view") && allowedLocation(locationId));
      allow create: if canModule("locations", "create");
      allow update: if isAdmin()
        || (canModule("locations", "edit")
          && allowedLocation(locationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name", "type", "codePrefix", "dniMode", "active",
            "scheduleStartAt", "scheduleEndAt", "startDateTime", "endDateTime",
            "manualInactiveUntil", "manualInactiveDays", "updatedBy", "updatedByName",
            "updatedAt"
          ]))
        || (canModule("locations", "archive")
          && allowedLocation(locationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "active", "deleted", "deletedAt", "deletedBy", "updatedBy", "updatedByName", "updatedAt"
          ]))
        || (canModule("locations", "restore")
          && allowedLocation(locationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "active", "deleted", "deletedAt", "restoredAt", "restoredBy", "updatedBy", "updatedByName", "updatedAt"
          ]))
        || (canModule("locations", "assignDiscounts")
          && allowedLocation(locationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "enabledDiscountIds", "updatedBy", "updatedByName", "updatedAt"
          ]))
        || ((canModule("locations", "loadStock") || canModule("locations", "adjustStock"))
          && allowedLocation(locationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "stockConfiguredAt", "updatedBy", "updatedAt"
          ]));
      allow delete: if false;
    }
    match /products/{productId} {
      allow read: if activeUser() && (isAdmin() || resource.data.active == true);
      allow create, update: if isAdmin() || canModule("ecommerce", "edit");
      allow delete: if false;
    }
    match /productCategories/{categoryId} {
      allow read: if activeUser() && (isAdmin() || resource.data.active == true);
      allow create, update: if isAdmin() || canModule("ecommerce", "edit");
      allow delete: if false;
    }
    match /discounts/{discountId} {
      allow read: if activeUser() && (isAdmin() || resource.data.active == true);
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /settings/{settingId} {
      allow get: if activeUser();
      allow list, create, update: if isAdmin();
      allow delete: if false;
    }
    match /locationStock/{locationId} {
      allow read, write: if isAdmin();
      match /items/{productId} {
        allow read: if activeUser() && allowedLocation(locationId);
        allow create: if isAdmin()
          || ((canModule("warehouse", "edit")
              || canModule("locations", "configureLocationProducts")
              || canModule("locations", "loadStock")
              || canModule("locations", "adjustStock"))
            && allowedLocation(locationId)
            && request.resource.data.productId == productId
            && request.resource.data.currentStock is int
            && request.resource.data.currentStock >= 0);
        allow update: if isAdmin()
          || validSellerStockMutation(locationId, productId)
          || (canModule("warehouse", "edit") && allowedLocation(locationId))
          || (canModule("locations", "configureLocationProducts")
            && allowedLocation(locationId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "productId", "productName", "abbreviation", "categoryId", "categoryName",
              "imageUrl", "thumbUrl", "price", "yellowAlertQty", "redAlertQty",
              "active", "deleted", "updatedAt", "updatedBy"
            ]))
          || ((canModule("locations", "loadStock") || canModule("locations", "adjustStock"))
            && allowedLocation(locationId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "productId", "productName", "abbreviation", "categoryId", "categoryName",
              "imageUrl", "thumbUrl", "price", "initialStock", "currentStock",
              "yellowAlertQty", "redAlertQty", "active", "deleted", "deletedAt",
              "productDeleted", "updatedAt", "updatedBy"
            ])
            && request.resource.data.currentStock is int
            && request.resource.data.currentStock >= 0);
        allow delete: if false;
      }
    }
    match /sales/{saleId} {
      allow get: if isAdmin()
        || (activeUser() && resource.data.sellerId == request.auth.uid)
        || (canModule("quick-sales", "view") && allowedLocation(resource.data.locationId));
      allow list: if isAdmin()
        || (activeUser() && resource.data.sellerId == request.auth.uid)
        || (canModule("quick-sales", "view") && allowedLocation(resource.data.locationId));
      allow create: if isAdmin()
        || (quickSalesPermission("create")
          && activeQuickSalesLocation(request.resource.data.locationId)
          && validSale(request.resource.data));
      allow update: if isAdmin()
        || (quickSalesPermission("edit")
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.locationId == resource.data.locationId
          && resource.data.status == "active"
          && request.resource.data.status in ["active", "cancelled"]
          && ((request.resource.data.status == "active" && activeQuickSalesLocation(resource.data.locationId))
            || (request.resource.data.status == "cancelled" && allowedLocation(resource.data.locationId))));
      allow delete: if false;
    }
    match /stockMovements/{movementId} {
      allow read: if isAdmin()
        || ((canModule("warehouse", "view") || canModule("locations", "view"))
          && allowedLocation(resource.data.locationId));
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && allowedLocation(request.resource.data.locationId)
        && request.resource.data.previousStock is int
        && request.resource.data.newStock is int
        && request.resource.data.saleId is string;
      allow update, delete: if false;
    }
    match /stockOperations/{operationId} {
      allow get: if activeUser() && (
        !exists(/databases/$(database)/documents/stockOperations/$(operationId))
        || isAdmin()
        || allowedLocation(resource.data.locationId)
      );
      allow list: if isAdmin();
      allow create: if activeUser()
        && request.resource.data.userId == request.auth.uid
        && allowedLocation(request.resource.data.locationId)
        && (canModule("locations", "loadStock") || canModule("locations", "adjustStock") || canModule("warehouse", "edit"));
      allow update, delete: if false;
    }
    match /stockTransfers/{transferId} {
      allow read: if canModule("warehouse", "view");
      allow create: if canModule("warehouse", "create") && ownsNewRecord();
      allow update: if canModule("warehouse", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /counters/{counterId} {
      allow get: if activeUser();
      allow list: if isAdmin();
      allow create: if signedIn()
        && allowedLocation(request.resource.data.locationId)
        && request.resource.data.lastNumber == 1;
      allow update: if signedIn()
        && allowedLocation(resource.data.locationId)
        && request.resource.data.locationId == resource.data.locationId
        && request.resource.data.lastNumber == resource.data.lastNumber + 1;
      allow delete: if false;
    }
    match /customers/{customerId} {
      allow read: if canModule("loyal-customers", "view");
      allow create: if canModule("loyal-customers", "create") && ownsNewRecord();
      allow update: if canModule("loyal-customers", "edit") && logicalMutation();
      allow delete: if false;
      match /interactions/{interactionId} {
        allow read: if canModule("loyal-customers", "view");
        allow create, update: if canModule("loyal-customers", "edit");
        allow delete: if false;
      }
    }
    match /orders/{orderId} {
      allow read: if canModule("ecommerce", "view");
      allow create: if canModule("ecommerce", "create") && ownsNewRecord();
      allow update: if canModule("ecommerce", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /shipments/{shipmentId} {
      allow read: if canModule("shipping", "view");
      allow create: if canModule("shipping", "create") && ownsNewRecord();
      allow update: if canModule("shipping", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /invoices/{invoiceId} {
      allow read: if canModule("finance", "view");
      allow create, update: if canModule("finance", "edit");
      allow delete: if false;
    }
    match /financialEntries/{entryId} {
      allow read: if canModule("finance", "view");
      allow create: if canModule("finance", "create") && ownsNewRecord();
      allow update: if canModule("finance", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /cashSessions/{sessionId} {
      allow read: if canModule("finance", "view");
      allow create, update: if canModule("finance", "edit");
      allow delete: if false;
    }
    match /suppliers/{supplierId} {
      allow read: if canModule("suppliers", "view");
      allow create: if canModule("suppliers", "create") && ownsNewRecord();
      allow update: if canModule("suppliers", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /purchases/{purchaseId} {
      allow read: if canModule("suppliers", "view");
      allow create: if canModule("suppliers", "create") && ownsNewRecord();
      allow update: if canModule("suppliers", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /campaigns/{campaignId} {
      allow read: if canModule("marketing", "view");
      allow create: if canModule("marketing", "create") && ownsNewRecord();
      allow update: if canModule("marketing", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /contentItems/{contentId} {
      allow read: if canModule("marketing", "view");
      allow create, update: if canModule("marketing", "edit");
      allow delete: if false;
    }
    match /socialLeads/{leadId} {
      allow read: if canModule("social", "view");
      allow create: if canModule("social", "create") && ownsNewRecord();
      allow update: if canModule("social", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /alerts/{alertId} {
      allow read: if canModule("alerts", "view")
        && (!("responsibleId" in resource.data) || resource.data.responsibleId == request.auth.uid || isAdmin());
      allow create: if canModule("alerts", "create") && ownsNewRecord();
      allow update: if canModule("alerts", "edit") && logicalMutation();
      allow delete: if false;
    }
    match /dailySummaries/{summaryId} {
      allow read: if canModule("metrics", "view");
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /auditLogs/{logId} {
      allow read: if isAdmin()
        || (canModule("locations", "view")
          && ("locationId" in resource.data)
          && allowedLocation(resource.data.locationId));
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && (isAdmin()
          || (("locationId" in request.resource.data)
            && allowedLocation(request.resource.data.locationId)));
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
