VITE_FIREBASE_API_KEY=AIzaSyCBVuIt36d_0DbDdEkGwRy85hmpZEjbrVg
VITE_FIREBASE_AUTH_DOMAIN=app-integral-fm.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=app-integral-fm
VITE_FIREBASE_STORAGE_BUCKET=app-integral-fm.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=447903189609
VITE_FIREBASE_APP_ID=1:447903189609:web:ffab0ee93aa45f7fe5b0f8

# ARCA / Facturacion electronica (server-side Netlify Functions only)
# Homologation first. Never expose these as VITE_* variables.
ARCA_ENVIRONMENT=homologation
ARCA_ISSUER_CUIT=
ARCA_POINT_OF_SALE=
ARCA_CERTIFICATE_PEM=
ARCA_PRIVATE_KEY_PEM=

# Backend fiscal / Firestore server-only
# Crear una cuenta de servicio exclusiva para el backend de facturación.
# No usar variables VITE_* para estas credenciales.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Condición IVA del emisor usada para resolver clase de comprobante.
# Valores soportados por ahora: responsable_inscripto
ARCA_ISSUER_VAT_CONDITION=

# Datos visibles del emisor requeridos para renderizar el comprobante PDF.
# Son server-side; no usar prefijo VITE_.
ARCA_ISSUER_LEGAL_NAME=
ARCA_ISSUER_COMMERCIAL_ADDRESS=
# Compatibilidad temporal: si COMMERCIAL_ADDRESS está vacío, se acepta este campo legado.
ARCA_ISSUER_FISCAL_ADDRESS=
ARCA_ISSUER_GROSS_INCOME=
ARCA_ISSUER_ACTIVITY_START=

# Interruptor explícito: mientras esté vacío/false, ningún endpoint puede solicitar CAE.
# Habilitar solamente durante una prueba controlada de homologación.
ARCA_ALLOW_CAE_HOMOLOGATION=false

# Flor Mía confirmó que los productos actualmente facturados usan IVA 21%.
# Un valor explícito por producto sigue teniendo prioridad sobre este fallback.
ARCA_DEFAULT_PRODUCT_VAT_RATE=21

# Umbral vigente de identificación obligatoria para Consumidor Final.
# Mantener alineado con la normativa vigente de ARCA.
ARCA_CONSUMER_FINAL_ID_THRESHOLD=10000000


# Caché compartida WSAA entre Functions.
# Base64 de 32 bytes (AES-256-GCM). Obligatoria antes de producción.
# Generar fuera del repositorio, por ejemplo: openssl rand -base64 32
ARCA_TA_ENCRYPTION_KEY=


# Interruptor operativo de seguridad para conexiones productivas read-only.
# Permite health checks, WSAA/WSFE de consulta y readiness sin emitir comprobantes.
# No habilita CAE por sí solo.
ARCA_ALLOW_PRODUCTION_READONLY=false


# Interruptor operativo de seguridad para preparar snapshots/solicitudes fiscales productivas.
# PREPARE no emite CAE; sólo permite crear/reutilizar la solicitud idempotente asociada a la venta.
ARCA_ALLOW_PRODUCTION_INVOICE_PREPARE=false

# Habilita lookup de CUIT de clientes contra Padrón productivo.
# El preflight del propio emisor no necesita esta bandera.
ARCA_ALLOW_PRODUCTION_TAXPAYER_LOOKUP=false


# Interruptor operativo de seguridad para permitir solicitudes de CAE productivo.
# Debe administrarse como kill switch: habilitarlo no elimina idempotencia, sequence lock ni allowlist.
ARCA_ALLOW_PRODUCTION_CAE=false

# Alcance exacto para una autorización MANUAL productiva controlada.
# Si tiene valor, sólo esa saleSnapshot.saleCode puede emitir.
# Para operación automática permanente debe quedar vacío: sin este valor la autorización manual productiva
# sigue cerrada, mientras la automática sólo puede operar si AUTO_AUTHORIZE + allowlist también están habilitados.
ARCA_PRODUCTION_CAE_SALE_CODE=


# Interruptor operativo de seguridad para autorización automática productiva.
# Requiere además PREPARE=true y ARCA_ALLOW_PRODUCTION_CAE=true.
# No habilita autorización manual.
ARCA_AUTO_AUTHORIZE_PRODUCTION=false

# Allowlist de orígenes que pueden disparar autorización automática.
# La primera etapa productiva queda acotada exclusivamente a Venta Rápida.
# Para habilitar otros flujos en una etapa posterior, agregarlos separados por coma.
ARCA_AUTO_AUTHORIZE_PRODUCTION_SOURCES=admin_quick_sale
