    subgraph navegador["Navegador · App Integral FM"]
        rapido["Venta Rápida · /gestion/quick-sales"]:::integral
        vendedor["Panel Vendedor · /vendedor"]:::integral
        offline[("IndexedDB · seller_pending_sales")]:::db
        ventasService["sellerService · transacción Firestore SDK"]:::shared
        crm["Clientes · /gestion/loyal-customers"]:::integral
