flowchart LR
    %% Flujo del macro-dominio verificado contra el corte d0f1225.
    subgraph navegador["Navegador · Gestión"]
        panel["Panel general · /gestion"]:::integral
        metricas["Métricas · /gestion/metrics/sales"]:::integral
        finanzas["Finanzas · /gestion/finance"]:::integral
        fiscal["Facturación desde POS y Configuración"]:::integral
    end

    subgraph servidor["Servidor · Functions"]
        preparar["arca-receiver · arca-invoice · arca-taxpayer"]:::shared
        resolver["arca-authorize · arca-document · sale-cancel"]:::shared
    end

    subgraph persistencia["Persistencia y servicios externos"]
        movimientos[("sales · financialEntries")]:::db
        comprobantes[("invoices · arcaSequenceLocks")]:::db
        arca(["ARCA · WSAA, WSFE y Padrón"]):::external
        smtp(["SMTP · PDF autorizado"]):::external
        faltantes["INCOMPLETO · Exportación y sesiones cashSessions"]:::debt
    end

    panel --> movimientos
    metricas --> movimientos
    finanzas --> movimientos
    metricas -.-> faltantes
    finanzas -.-> faltantes
    fiscal --> preparar
    fiscal --> resolver
    preparar --> arca
    resolver --> comprobantes
    resolver -->|CAE y nota de crédito| arca
    resolver -.-> smtp

    classDef actor fill:#1E293B,stroke:#64748B,color:#FFFFFF,stroke-width:2px
    classDef integral fill:#1D4ED8,stroke:#1E40AF,color:#FFFFFF,stroke-width:2px
    classDef ecommerce fill:#047857,stroke:#065F46,color:#FFFFFF,stroke-width:2px
    classDef shared fill:#6D28D9,stroke:#5B21B6,color:#FFFFFF,stroke-width:2px
    classDef db fill:#B45309,stroke:#92400E,color:#FFFFFF,stroke-width:2px
    classDef external fill:#475569,stroke:#334155,color:#FFFFFF,stroke-width:2px,stroke-dasharray:5 4
    classDef debt fill:#B91C1C,stroke:#7F1D1D,color:#FFFFFF,stroke-width:2px,stroke-dasharray:5 4
