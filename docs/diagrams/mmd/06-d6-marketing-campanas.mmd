flowchart TB
    %% Registro, planeamiento, mensajes y etapas pendientes de publicación.
    subgraph navegador["En tu navegador o celular"]
        marketing["Campañas generales en borrador"]:::debt
        redes["Contactos de redes sociales"]:::integral
        anuncios["Plan y piezas para anuncios en Meta"]:::integral
