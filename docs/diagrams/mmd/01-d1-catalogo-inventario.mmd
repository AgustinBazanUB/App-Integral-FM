flowchart TB
    %% Administración del catálogo y de las existencias.
    subgraph navegador["En tu navegador o celular"]
        depositos["Stock de depósitos"]:::integral
        proveedores["Pantalla de proveedores incompleta"]:::debt
        productos["Cargar y editar productos"]:::integral
        cambios["Ingresos, ajustes y traslados"]:::integral
        locales["Stock de locales"]:::integral
    end
    subgraph servidor["En el servidor seguro"]
        unir["Unir productos duplicados"]:::shared
    end
    subgraph datos["Base de datos"]
        compras["Compras sin pantalla de gestión"]:::debt
        cantidad[("Existencias por local y depósito")]:::db
        catalogo[("Productos y categorías")]:::db
        fichas[("Fichas de proveedores")]:::db
        historial[("Historial de movimientos y traslados")]:::db
    end
    productos -->|"Solicita la unión"| unir
    cambios -->|"Deja constancia de cada cambio"| historial
    cambios -->|"Actualiza cantidades"| cantidad
    depositos -->|"Permite ingresar o trasladar"| cambios
    locales -->|"Permite mover o ajustar"| cambios
    productos -->|"Guarda altas y cambios"| catalogo
    unir -->|"Consolida las fichas"| catalogo
    proveedores -.->|"No permite gestionar compras"| compras
    proveedores -->|"Muestra las fichas"| fichas

    classDef actor fill:#1E293B,stroke:#64748B,color:#FFFFFF,stroke-width:2px
    classDef integral fill:#1D4ED8,stroke:#1E40AF,color:#FFFFFF,stroke-width:2px
    classDef ecommerce fill:#047857,stroke:#065F46,color:#FFFFFF,stroke-width:2px
    classDef shared fill:#6D28D9,stroke:#5B21B6,color:#FFFFFF,stroke-width:2px
    classDef db fill:#B45309,stroke:#92400E,color:#FFFFFF,stroke-width:2px
    classDef external fill:#475569,stroke:#334155,color:#FFFFFF,stroke-width:2px,stroke-dasharray:5 4
    classDef debt fill:#B91C1C,stroke:#7F1D1D,color:#FFFFFF,stroke-width:2px,stroke-dasharray:5 4
